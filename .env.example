# --- RPC & Network (Alchemy/Infura) ---
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key_here

# --- WalletConnect / Reown ---
NEXT_PUBLIC_WC_PROJECT_ID=your_walletconnect_project_id_here

# --- EAS (Ethereum Attestation Service) ---
# Update this hash once you register your own schema or use the default staging schema
NEXT_PUBLIC_EAS_SCHEMA_UID=your_eas_schema_uid_here

# --- World ID ---
NEXT_PUBLIC_WORLD_ID_APP_ID=your_world_id_app_id_here

# --- Deployment / Scripts Only (Do NOT prefix with NEXT_PUBLIC_) ---
# Private key for deploying schema, running tests or backend scripts
SEPOLIA_PRIVATE_KEY=your_private_key_without_0x_prefix_here

# --- Hedera Consensus Service (HCS) ---
NEXT_PUBLIC_HEDERA_TOPIC_ID=0.0.YOUR_TOPIC_ID
HEDERA_ACCOUNT_ID=0.0.YOUR_ACCOUNT_ID
HEDERA_PRIVATE_KEY=your_hedera_private_key_here
